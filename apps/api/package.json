{
  "name": "@job-agent/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json && node dist/src/main.js",
    "migrate": "tsc -p tsconfig.json && node dist/src/migrate.js",
    "test": "tsc -p tsconfig.json && node dist/src/migrate.js && node --test --test-concurrency=1 \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "mammoth": "^1.13.0",
    "playwright": "^1.65.0",
    "unpdf": "^2.1.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "~5.9.0"
  }
}
