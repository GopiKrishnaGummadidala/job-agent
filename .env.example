# Copy to .env. Defaults below match docker-compose.yml and are for local development only.

# Owner connection: used only by `npm run migrate`.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/jobagent
# Restricted application role: row-level security applies to this role.
APP_DB_PASSWORD=app_dev_password
DATABASE_URL=postgres://jobagent_app:app_dev_password@localhost:5433/jobagent

PORT=4000
WEB_ORIGIN=http://localhost:5173
# Set to true behind HTTPS.
COOKIE_SECURE=false
# Background board refresh (every 30 min, boards older than 6 h). Set to off to disable.
SCHEDULER=on
# Browser assist: opens a visible Chromium on the machine running the API and pre-fills approved
# applications (never submits). Only meaningful when the API runs on your own computer.
ASSIST=local

# Hosted mode serves the built web app and API from one HTTPS origin.
# JOB_AGENT_HOSTED=true
# JOB_AGENT_SIGNUP_EMAILS=owner@example.test,delegate@example.test
# RESUME_BUILDER_ROOT=C:/path/to/resume-builder

# Gmail OAuth web client. Keep the secret and the stable base64-encoded 32-byte key in .env.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5173/api/me/gmail/callback
GMAIL_TOKEN_KEY=

# --- AI providers (each user picks provider + model in Settings; keys and URLs stay server-side) ---
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Price per million tokens for the OpenAI-compatible provider, used only for budget tracking.
OPENAI_PRICE_IN=0
OPENAI_PRICE_OUT=0
ANTHROPIC_API_KEY=
